{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BetterTick",
  "version": "0.1.0",
  "identifier": "com.bettertick.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BetterTick",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ]
  }
}