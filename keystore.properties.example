# keystore.properties.example
# 이 파일을 복사해서 keystore.properties 로 만들고 실제 값 입력
# keystore.properties 는 .gitignore 에 포함되어 있어 절대 커밋되지 않습니다.
#
# 키스토어 생성 방법:
#   keytool -genkey -v -keystore bettertick.keystore -alias bettertick \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# GitHub Actions Secrets 등록 방법:
#   1. 키스토어 Base64 인코딩:
#      base64 -i bettertick.keystore | pbcopy   (macOS)
#      certutil -encode bettertick.keystore tmp.b64 && type tmp.b64  (Windows)
#   2. GitHub 레포 → Settings → Secrets and variables → Actions → New repository secret
#      KEYSTORE_BASE64  = (위에서 복사한 Base64)
#      STORE_PASSWORD   = (아래 storePassword 값)
#      KEY_ALIAS        = (아래 keyAlias 값)
#      KEY_PASSWORD     = (아래 keyPassword 값)

storeFile=bettertick.keystore
storePassword=your_store_password
keyAlias=bettertick
keyPassword=your_key_password
