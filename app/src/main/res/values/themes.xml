<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.BetterTick" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#FF121212</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowBackground">#FF121212</item>
    </style>

    <!-- Translucent variant used by QuickAddActivity so the launcher stays
         visible behind the floating task input dialog. -->
    <style name="Theme.BetterTick.QuickAdd" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Fully invisible theme for WidgetActionDispatcher. The dispatcher is
         a no-UI relay that finish()es in onCreate — no background, no
         animation, so the user never sees a flash between tap and widget
         refresh. -->
    <style name="Theme.BetterTick.Invisible" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
