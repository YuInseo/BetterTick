<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="10dp">

    <!-- Header: month label + nav + actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="4"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="‹  Apr  ›"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="+   ⋮"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Day-of-week row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="일" android:textColor="#707070" android:textSize="10sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="월" android:textColor="#707070" android:textSize="10sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="화" android:textColor="#707070" android:textSize="10sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="수" android:textColor="#707070" android:textSize="10sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="목" android:textColor="#707070" android:textSize="10sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="금" android:textColor="#707070" android:textSize="10sp" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="토" android:textColor="#707070" android:textSize="10sp" android:gravity="center" />
    </LinearLayout>

    <!-- Day-number row + tasks -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Day 19 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="20dp" android:layout_height="20dp" android:text="19" android:textColor="#FFFFFF" android:textSize="11sp" android:gravity="center" />
            <TextView android:layout_width="match_parent" android:layout_height="14dp" android:layout_marginHorizontal="1dp" android:layout_marginTop="2dp" android:background="@drawable/widget_chip_green" android:gravity="center_vertical" android:paddingHorizontal="3dp" android:text="장보기" android:textColor="#FFFFFF" android:textSize="9sp" android:maxLines="1" />
        </LinearLayout>

        <!-- Day 20 (today) -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/widget_circle_blue" android:text="20" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:layout_width="match_parent" android:layout_height="14dp" android:layout_marginHorizontal="1dp" android:layout_marginTop="2dp" android:background="@drawable/widget_chip_blue" android:gravity="center_vertical" android:paddingHorizontal="3dp" android:text="회의" android:textColor="#FFFFFF" android:textSize="9sp" android:maxLines="1" />
            <TextView android:layout_width="match_parent" android:layout_height="14dp" android:layout_marginHorizontal="1dp" android:layout_marginTop="2dp" android:background="@drawable/widget_chip_purple" android:gravity="center_vertical" android:paddingHorizontal="3dp" android:text="운동" android:textColor="#FFFFFF" android:textSize="9sp" android:maxLines="1" />
        </LinearLayout>

        <!-- Day 21 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="20dp" android:layout_height="20dp" android:text="21" android:textColor="#FFFFFF" android:textSize="11sp" android:gravity="center" />
            <TextView android:layout_width="match_parent" android:layout_height="14dp" android:layout_marginHorizontal="1dp" android:layout_marginTop="2dp" android:background="@drawable/widget_chip_orange" android:gravity="center_vertical" android:paddingHorizontal="3dp" android:text="기획" android:textColor="#FFFFFF" android:textSize="9sp" android:maxLines="1" />
        </LinearLayout>

        <!-- Day 22 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="20dp" android:layout_height="20dp" android:text="22" android:textColor="#FFFFFF" android:textSize="11sp" android:gravity="center" />
            <TextView android:layout_width="match_parent" android:layout_height="14dp" android:layout_marginHorizontal="1dp" android:layout_marginTop="2dp" android:background="@drawable/widget_chip_blue" android:gravity="center_vertical" android:paddingHorizontal="3dp" android:text="개발" android:textColor="#FFFFFF" android:textSize="9sp" android:maxLines="1" />
            <TextView android:layout_width="match_parent" android:layout_height="14dp" android:layout_marginHorizontal="1dp" android:layout_marginTop="2dp" android:background="@drawable/widget_chip_green" android:gravity="center_vertical" android:paddingHorizontal="3dp" android:text="리뷰" android:textColor="#FFFFFF" android:textSize="9sp" android:maxLines="1" />
        </LinearLayout>

        <!-- Day 23 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="20dp" android:layout_height="20dp" android:text="23" android:textColor="#FFFFFF" android:textSize="11sp" android:gravity="center" />
            <TextView android:layout_width="match_parent" android:layout_height="14dp" android:layout_marginHorizontal="1dp" android:layout_marginTop="2dp" android:background="@drawable/widget_chip_purple" android:gravity="center_vertical" android:paddingHorizontal="3dp" android:text="공부" android:textColor="#FFFFFF" android:textSize="9sp" android:maxLines="1" />
        </LinearLayout>

        <!-- Day 24 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="20dp" android:layout_height="20dp" android:text="24" android:textColor="#FFFFFF" android:textSize="11sp" android:gravity="center" />
            <TextView android:layout_width="match_parent" android:layout_height="14dp" android:layout_marginHorizontal="1dp" android:layout_marginTop="2dp" android:background="@drawable/widget_chip_orange" android:gravity="center_vertical" android:paddingHorizontal="3dp" android:text="여행" android:textColor="#FFFFFF" android:textSize="9sp" android:maxLines="1" />
        </LinearLayout>

        <!-- Day 25 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="20dp" android:layout_height="20dp" android:text="25" android:textColor="#FFFFFF" android:textSize="11sp" android:gravity="center" />
            <TextView android:layout_width="match_parent" android:layout_height="14dp" android:layout_marginHorizontal="1dp" android:layout_marginTop="2dp" android:background="@drawable/widget_chip_green" android:gravity="center_vertical" android:paddingHorizontal="3dp" android:text="휴식" android:textColor="#FFFFFF" android:textSize="9sp" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
