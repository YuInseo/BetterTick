# ──────────────────────────────────────────
#  BetterTick – Android .gitignore
# ──────────────────────────────────────────

# Built outputs
*.apk
*.aar
*.aab
*.ap_
*.dex
*.class

# Gradle build dirs
.gradle/
build/
**/build/

# Local config (SDK path, signing, device IP)
local.properties
keystore.properties
.device_ip

# Keystore files (never commit real keystores)
*.jks
*.keystore

# IntelliJ / Android Studio
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/modules.xml
.idea/navEditor.xml
.idea/deploymentTargetSelector.xml

# OS
.DS_Store
Thumbs.db

# Misc
captures/
.navigation/
.externalNativeBuild/
.cxx/
proguard/
*.log
